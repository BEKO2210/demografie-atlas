  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/demografie-atlas next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
