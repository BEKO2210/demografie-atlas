    "build:assets": "node scripts/build-world-data.mjs && node scripts/build-globe-texture.mjs && GLOBE_TEXTURE_WIDTH=4096 node scripts/build-globe-texture.mjs && node scripts/build-flag-sprite.mjs && node scripts/build-noise.mjs && node scripts/build-avif.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-globe.gl": "^2.38.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
